{
	"name": "@autter/runtime-node",
	"version": "1.5.0",
	"description": "Autter Runtime for Node.js: request wide events, coded errors, operation logging, same-origin browser relay and a curated OpenTelemetry server tracker",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js",
			"require": "./dist/testing.cjs"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"autter-runtime": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Autter-dev/autter-runtime.git",
		"directory": "packages/runtime-node"
	},
	"scripts": {
		"build": "tsup",
		"test": "npm run build -w @autter/runtime-core && npm run build && npm run build -w @autter/otlp-ingester && node --test test/*.test.mjs"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/core": "^1.30.1",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.57.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.57.1",
		"@opentelemetry/instrumentation-http": "^0.57.1",
		"@opentelemetry/resources": "^1.30.1",
		"@opentelemetry/sdk-metrics": "^1.30.1",
		"@opentelemetry/sdk-node": "^0.57.1",
		"@opentelemetry/sdk-trace-base": "^1.30.1",
		"@opentelemetry/semantic-conventions": "^1.28.0"
	},
	"devDependencies": {
		"@autter/runtime-core": "0.0.0",
		"@types/node": "^22.10.0",
		"express": "^4.21.2",
		"tsup": "^8.3.5",
		"typescript": "^5.7.0"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"homepage": "https://github.com/Autter-dev/autter-runtime#readme",
	"bugs": "https://github.com/Autter-dev/autter-runtime/issues",
	"keywords": [
		"opentelemetry",
		"otlp",
		"error-tracking",
		"telemetry",
		"nodejs",
		"express"
	]
}
